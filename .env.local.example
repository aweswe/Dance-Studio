# ═══ Supabase ═══
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ═══ Site ═══
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ═══ Razorpay (optional — omit to keep enrol as lead + WhatsApp) ═══
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ═══ UPI (shown when Razorpay is off) ═══
NEXT_PUBLIC_UPI_ID=

# ═══ WhatsApp API (WATI or Interakt) ═══
WHATSAPP_PROVIDER=interakt
WHATSAPP_API_KEY=
WHATSAPP_API_URL=https://api.interakt.ai/v1/public/message/

# ═══ Cron ═══
CRON_SECRET=your_custom_secure_cron_secret_string

# ═══ Optional durable rate limits (falls back to in-memory) ═══
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
