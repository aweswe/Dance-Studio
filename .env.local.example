# ═══ Supabase ═══
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ═══ Site ═══
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ═══ Homepage hero video (place MP4 in public/videos/) ═══
# NEXT_PUBLIC_HERO_VIDEO_URL=/videos/hyderabaddiaries-reel.mp4

# ═══ Payment Gateway Selection ('phonepe' or 'razorpay') ═══
NEXT_PUBLIC_PAYMENT_GATEWAY=phonepe

# ═══ PhonePe Payment Gateway v2 (OAuth Standard Checkout) ═══
# Set PHONEPE_ENV=production when going live, or PHONEPE_ENV=sandbox for UAT
PHONEPE_ENV=production
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_CLIENT_ID=your_client_id
PHONEPE_CLIENT_SECRET=your_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=your_webhook_username
PHONEPE_WEBHOOK_PASSWORD=your_webhook_password

# Legacy v1 Sandbox Fallback (auto-used if PHONEPE_CLIENT_ID/SECRET are omitted)
# PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
# PHONEPE_SALT_INDEX=1
# PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# ═══ Razorpay (legacy/alternative — optional) ═══
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ═══ UPI (shown when online gateway is off) ═══
NEXT_PUBLIC_UPI_ID=rhythmzz@upi

# ═══ WhatsApp API & Messaging ═══
# WATI automation is commented out in code — using manual WhatsApp Business help.
# WHATSAPP_PROVIDER=wati
WHATSAPP_PROVIDER=interakt
WHATSAPP_API_KEY=
WHATSAPP_API_URL=https://api.interakt.ai/v1/public/message/

# ═══ Cron ═══
CRON_SECRET=your_custom_secure_cron_secret_string

# ═══ Optional durable rate limits (falls back to in-memory) ═══
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
